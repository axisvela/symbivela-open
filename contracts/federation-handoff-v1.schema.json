{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://symbivela.axisrobo.io/contracts/federation-handoff/v1",
  "title": "SYMBIVELA Federation Handoff v1",
  "description": "Cross-organization partner handoff envelope for federated workspaces (EE). SYMBIVELA records the handoff; partner systems consume it through their own contracts.",
  "type": "object",
  "required": ["handoff_id", "partner_id", "subject_ref", "direction"],
  "properties": {
    "handoff_id": {"type": "string", "minLength": 1},
    "partner_id": {"type": "string", "minLength": 1},
    "subject_ref": {"type": "string", "minLength": 1},
    "direction": {"enum": ["out", "in"]},
    "status": {"enum": ["pending", "accepted", "rejected"]}
  }
}
